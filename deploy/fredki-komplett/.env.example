# ============================================================
#  FredKI® Komplett – Einstellungen
#  install.sh kopiert diese Datei nach .env (falls noch nicht vorhanden).
# ============================================================

# --- Domain (muss per DNS auf diesen Server zeigen, Ports 80 und 443 frei) ---
DOMAIN=claudefred.lernsteine.com

# --- Bild-/Sprachmodell (Ministral 3 auf dem GPU-Server) ---
# vllm   = Modell läuft mit "vllm serve" (OpenAI-kompatibel)
# ollama = Modell läuft in Ollama
MODEL_PROVIDER=vllm

# Adresse des Modellservers, vom FredKI-Server aus erreichbar
#   vLLM:   http://<gpu-server>:8000/v1
#   Ollama: http://<gpu-server>:11434
MODEL_API_URL=

# API-Schlüssel des Modellservers (leer lassen, wenn keiner nötig ist)
MODEL_API_KEY=

# Name des Modells am Modellserver. Leer = automatisch erkennen
# (bevorzugt ein Modell mit "ministral" im Namen).
MODEL_NAME=

# --- Admin-Zugang ---
# Leer = sicheres Passwort wird erzeugt und in daten/setup/admin-passwort.txt abgelegt.
# Sonst: 6–20 Zeichen mit Klein- und Großbuchstaben, Ziffer und Sonderzeichen.
FREDKI_ADMIN_PASSWORD=

# --- Name des automatisch angelegten Agenten ---
AGENT_NAME=FredKI Assistent

# --- Zugang zum FredKI-Paket (von LERNSTEINE bereitgestellt) ---
# GitHub-Benutzer und Lese-Token (nur Berechtigung "read:packages").
# install.sh meldet sich damit automatisch an. Leer lassen, wenn das Paket öffentlich ist.
GHCR_USER=
GHCR_TOKEN=

# --- Technisches (normalerweise nicht ändern) ---
FREDKI_IMAGE=ghcr.io/lernsteine/fredki-lab:latest
# wird von install.sh automatisch erzeugt
SEARXNG_SECRET=
