# Kopieren nach .env und bei Bedarf anpassen.

# Welche Version installiert wird:
#   latest    = immer der neueste Stand
#   <commit>  = eine feste Version, z. B. 1fd38a4
FREDKI_IMAGE=ghcr.io/lernsteine/fredki-lab:latest

# Port, unter dem FredKI auf dem Server erreichbar ist
# (davor gehört ein HTTPS-Proxy, z. B. nginx, Caddy oder Traefik)
FREDKI_PORT=8080

# Verzeichnis für alle Daten (Datenbank, Uploads, Logs)
FREDKI_DATA_DIR=/opt/fredki

FREDKI_CONTAINER_NAME=fredki
